# Common defaults for every build. Chip-revision files add to this one:
#   sdkconfig.defaults.rev3  (v3.x silicon, ESP32-P4NRW32X current stock)
#   sdkconfig.defaults.rev1  (v1.3 silicon, older stock)
CONFIG_IDF_TARGET="esp32p4"

# Flash and partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# 32 MB PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# RTOS
CONFIG_FREERTOS_HZ=1000
# Per-task run time and stack size for the System tab (/api/tasks). Run time
# in esp_timer microseconds, 64-bit so it does not wrap.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Recovery and diagnostics (ADR-0009)
# Log ring in PSRAM .noinit: kept across software resets and panics.
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Ethernet: internal EMAC + IP101
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y

# Security: secure boot and flash encryption OFF until explicitly decided.
# Enabling either one burns eFuses permanently on first boot, even in
# development mode. See docs/adr/0002.
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set

# NVS encryption OFF: the HMAC scheme (ADR-0006) would burn eFuse BLOCK_KEY5.
# Declined 2026-11-21 until secure boot is decided.
# CONFIG_NVS_ENCRYPTION is not set

# OTA and rollback (ADR-0008). No eFuse is burned by any of these.
# Rollback lives in the bootloader: it arrives only with a USB flash.
# Never add CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK: it burns eFuses.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# OTA images must be signed (Secure Boot v2 RSA-3072 signature block) by the
# key in the running image. Not checked at boot; hardware secure boot is off.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# Signing during the build is set by tools/build.sh: on when the key exists
# (outside the repo), off otherwise (CI). An unsigned image cannot accept OTA.
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set

# Management web UI over HTTPS (ADR-0010): on-device self-signed certificate.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Wi-Fi: ESP32-C6 co-processor via ESP-Hosted (SDIO inside the module)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y

# BLE Wi-Fi provisioning (ADR-0014): NimBLE on the P4, the C6 is the BLE
# controller (HCI over the SDIO link; c6-firmware has Bluetooth on).
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
# Security 1 (X25519 + AES-CTR) without PoP: no label or display to show a PoP.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
