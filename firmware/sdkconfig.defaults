# Common defaults for every build. Chip-revision files add to this one:
#   sdkconfig.defaults.rev3  (v3.x silicon, ESP32-P4NRW32X current stock)
#   sdkconfig.defaults.rev1  (v1.3 silicon, older stock)
CONFIG_IDF_TARGET="esp32p4"

# Flash and partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# 32 MB PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# RTOS
CONFIG_FREERTOS_HZ=1000

# Recovery and diagnostics
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Ethernet: internal EMAC + IP101
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y

# Security: secure boot and flash encryption OFF until explicitly decided.
# Enabling either one burns eFuses permanently on first boot, even in
# development mode. See docs/adr/0002.
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set

# NVS encryption OFF: the HMAC scheme (ADR-0006) would burn eFuse BLOCK_KEY5.
# Declined 2026-11-21 until secure boot is decided.
# CONFIG_NVS_ENCRYPTION is not set

# Wi-Fi: ESP32-C6 co-processor via ESP-Hosted (SDIO inside the module)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
